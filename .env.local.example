# Copia este archivo a .env.local (nunca lo subas a git, ya esta ignorado) y
# llena las llaves que tengas. El Estudio de contenido funciona con datos de
# ejemplo si dejas alguna vacia; en cuanto agregues la llave, ese proveedor
# empieza a generar contenido real.

# Llave PRINCIPAL recomendada — Gemini tiene un nivel gratis generoso, asi
# que con solo esta llave (sin pagar nada) ya funciona en vivo: Estudio de
# contenido, Chat de cada artista, Noticias (busqueda web), "Importar desde
# un enlace", y el copiloto "CMD-Neural AI" del HUD. El resto de las llaves
# de abajo (Anthropic, OpenAI) son opcionales — solo hacen falta si prefieres
# pagar por Claude o ChatGPT en vez de usar Gemini.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Opcional. Respaldo de pago para el Chat, Noticias e "Importar desde un
# enlace" si prefieres Claude sobre Gemini (o si Gemini falla). El orden de
# intento es: Gemini primero, despues Claude, despues ChatGPT, y si ninguna
# esta configurada, datos de ejemplo.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional. Respaldo de pago para el Estudio de contenido y el Chat si
# prefieres ChatGPT sobre Gemini/Claude (o si ambas fallan).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Pestana "Difusion" — enviar un mensaje por Telegram. Crea un bot con
# @BotFather (te da el token) y agrega ese bot a tu canal/grupo para obtener
# el chat_id (ej. con https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pestana "Difusion" — enviar un mensaje por WhatsApp (Meta Cloud API).
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# Cuentas de acceso (login por contrasena). Deja todo esto vacio y el panel
# se queda tan abierto como siempre — en cuanto configures UNA de estas, se
# activa la pantalla de inicio de sesion para todo el mundo. AUTH_SECRET
# firma la sesion; genera algo aleatorio (ej. `openssl rand -hex 32`) antes
# de usar esto en produccion.
AUTH_SECRET=
ADMIN_PASSWORD=
ARTIST_PASSWORD_PACHEMAN=
ARTIST_PASSWORD_MAX_AVENTURA=
ARTIST_PASSWORD_EL_REAL_SOPRANO=

# YouTube Studio — "Conectar tu cuenta de YouTube" (OAuth real de Google
# para ver estadisticas organicas del canal: vistas, minutos vistos,
# suscriptores ganados). Crea un proyecto en Google Cloud Console, activa
# "YouTube Data API v3" y "YouTube Analytics API", crea credenciales OAuth
# 2.0 (tipo "Web application"), y agrega como "Authorized redirect URI"
# exactamente: <tu-dominio>/api/youtube/auth/callback (uno por cada dominio
# donde corras la app, incluyendo http://localhost:3000 para desarrollo).
# Mientras la pantalla de consentimiento OAuth este en modo "Testing" (el
# default), agrega la cuenta de Google de cada artista como "Test user" en
# esa misma pantalla — asi no hace falta pasar por la revision de Google.
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
