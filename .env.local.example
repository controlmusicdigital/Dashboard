# Copia este archivo a .env.local (nunca lo subas a git, ya esta ignorado) y
# llena las llaves que tengas. El Estudio de contenido funciona con datos de
# ejemplo si dejas alguna vacia; en cuanto agregues la llave, ese proveedor
# empieza a generar contenido real.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Chatbot de cada artista (pestana "Chat con <artista>"). Sin esta llave,
# responde con mensajes de ejemplo. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
